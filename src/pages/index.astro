---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const awards = (await getCollection('achievements'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Zane Zhang',
  alternateName: '张永轩',
  url: 'https://zhangyx0803.github.io/',
  email: 'mailto:zhangyx0803@petalmail.com',
  jobTitle: '地理信息科学',
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: '上海师范大学',
  },
  knowsAbout: ['GIS', 'Remote Sensing', 'Spatial Analysis', 'Urban Heat Island'],
  sameAs: ['https://github.com/zhangyx0803'],
};
---

<Base
  title="Zane Zhang · 地理信息科学"
  description="Zane Zhang，上海师范大学地理信息科学本科。研究城市冷岛网络的跨期演变：遥感反演、MSPA、最小累积阻力与电路理论。"
  jsonLd={jsonLd}
>
  <section class="intro">
    <div class="wrap intro-grid">
      <div>
        <h1>
          Zane Zhang <span class="cn">张永轩</span>
        </h1>
        <p class="affil">
          <span class="t-zh">上海师范大学 · 环境与地理科学学院 · 地理信息科学 · 本科在读</span>
          <span class="t-en">Shanghai Normal University · School of Environmental and Geographical Sciences · Geographic Information Science · undergraduate</span>
        </p>
        <p class="statement">
          <span class="t-zh">
            研究方向为城市热环境与景观连通性。以三期 Landsat 影像反演地表温度，识别冷源与源地，
            构建冷岛廊道网络，并通过析因分解量化源地格局与阻力面对网络变化的贡献。
          </span>
          <span class="t-en">
            Research interests: urban thermal environment and landscape connectivity. I retrieve land
            surface temperature from three periods of Landsat imagery, identify cold sources and patches,
            build a cool-island corridor network, and decompose the contributions of source pattern and
            resistance surface to its change.
          </span>
        </p>
        <p class="links-row">
          <a href="mailto:zhangyx0803@petalmail.com">Email</a>
          <a href="https://github.com/zhangyx0803">GitHub</a>
          <a href="/cv/">CV</a>
          <span class="t-zh">· 更新于 2026.11</span><span class="t-en">· updated 2026.11</span>
        </p>
      </div>
      <div class="portrait">
        <span class="t-zh">照片<br />待补</span>
        <span class="t-en">photo<br />TBC</span>
      </div>
    </div>
  </section>

  <section class="section" id="research">
    <div class="wrap">
      <h2><span class="t-zh">研究</span><span class="t-en">Research</span></h2>
      {projects.map((p, i) => (
        <div class="row" data-reveal>
          <div class="when">{p.data.period.split('—')[0].trim()}</div>
          <div>
            <h3>
              <a href={`/projects/${p.id}/`}>
                <span class="t-zh">{p.data.title}</span><span class="t-en">{p.data.titleEn ?? p.data.title}</span>
              </a>
            </h3>
            <p class="sub">
              <span class="t-zh">{p.data.status}</span><span class="t-en">{p.data.statusEn ?? p.data.status}</span>
              {p.data.methods.length > 0 && (
                <span class="t-zh"> · {p.data.methods.slice(0, 4).join(' · ')}</span>
              )}
              {p.data.methodsEn.length > 0 && (
                <span class="t-en"> · {p.data.methodsEn.slice(0, 4).join(' · ')}</span>
              )}
            </p>
            <p class="desc">
              <span class="t-zh">{p.data.summary}</span><span class="t-en">{p.data.summaryEn ?? p.data.summary}</span>
            </p>
            <p class="links">
              <a href={`/projects/${p.id}/`}>
                <span class="t-zh">数据与复现</span><span class="t-en">Data &amp; reproduction</span>
              </a>
              {p.data.repo && <a href={p.data.repo}>GitHub</a>}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  {awards.length > 0 && (
    <section class="section" id="output">
      <div class="wrap">
        <h2><span class="t-zh">成果</span><span class="t-en">Output</span></h2>
        {awards.map((a, i) => (
          <div class="row" data-reveal>
            <div class="when">{a.data.issued ? String(a.data.issued.getFullYear()) : '2026'}</div>
            <div>
              <h3>
                <span class="kind"><span class="t-zh">{a.data.kind}</span><span class="t-en">{a.data.kindEn ?? a.data.kind}</span></span>
                <span class="t-zh">{a.data.title}</span><span class="t-en">{a.data.titleEn ?? a.data.title}</span>
              </h3>
              <p class="sub">
                <span class="t-zh">
                  {[a.data.number && `登记号 ${a.data.number}`, a.data.certificate].filter(Boolean).join(' · ')}
                </span>
                <span class="t-en">
                  {[a.data.number && `Reg. ${a.data.number}`, a.data.certificateEn ?? a.data.certificate].filter(Boolean).join(' · ')}
                </span>
              </p>
              <p class="links">
                {a.data.related && (
                  <a href={`/projects/${a.data.related}/`}>
                    <span class="t-zh">关联项目</span><span class="t-en">Related project</span>
                  </a>
                )}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="contact" id="contact">
    <div class="wrap">
      <h2><span class="t-zh">联系</span><span class="t-en">Contact</span></h2>
      <p class="cta">
        <span class="t-zh">如需数据或合作，请联系：</span>
        <span class="t-en">For data or collaboration, please write to:</span>
      </p>
      <a class="mail" href="mailto:zhangyx0803@petalmail.com">zhangyx0803@petalmail.com</a>
      <p class="meta">
        <span class="t-zh">31.1650°N 121.4050°E · 上海 · 徐汇</span>
        <span class="t-en">31.1650°N 121.4050°E · Shanghai</span>
      </p>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import mapSvg from '../assets/map-scene.svg?raw';
import { tracks } from '../data/log';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const notes = (await getCollection('notes'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
const awards = (await getCollection('achievements'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Zane Zhang',
  alternateName: '张永轩',
  url: 'https://zhangyx0803.github.io/',
  email: 'mailto:zhangyx0803@petalmail.com',
  jobTitle: '地理信息科学',
  knowsAbout: ['GIS', 'Remote Sensing', 'Spatial Analysis', 'Urban Heat Island', 'Cartography'],
  sameAs: ['https://github.com/zhangyx0803'],
};
---

<Base
  title="Zane Zhang · 地理信息科学"
  description="Zane Zhang，地理信息科学。研究城市冷岛网络的跨期演变、遥感反演与专题制图；逐日记录进度、数据来源与复现步骤。"
  jsonLd={jsonLd}
>
  <section class="hero" data-nav="light">
    <div class="wrap">
      <span class="hand">你好</span>
      <h1>Zane Zhang</h1>
      <p class="lede">
        地理信息科学。研究城市冷岛网络的跨期演变，也整理遥感反演与专题制图里那些容易写错的地方。
      </p>
      <p class="meta">
        <b>31.1650°N&nbsp;&nbsp;121.4050°E</b> · 上海 · 徐汇 · <span id="weather">正在读取天气…</span>
      </p>
    </div>
  </section>

  <section class="section atlas" id="map">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mask"><span>从国土，到一条街。</span></h2>
        <p data-reveal>同一套 Albers 投影，一张图，三个尺度。往下滚，镜头连续推近。</p>
      </div>

      <div class="atlas-grid">
        <div class="atlas-stage" id="stage" data-step="0" aria-hidden="true">
          <div id="scene" class="scene" set:html={mapSvg}></div>
          <div class="atlas-labels" id="labels">
            <span class="mk lv0 lv1 lv2" data-p="shanghai"></span>
            <span class="lbl lv0 lv1 lv2" data-p="shanghai" data-dx="10" data-dy="-8">上海</span>
            <span class="mk lv1" data-p="nanjing"></span>
            <span class="lbl lv1" data-p="nanjing" data-dx="9" data-dy="-4">南京</span>
            <span class="mk lv1" data-p="hangzhou"></span>
            <span class="lbl lv1" data-p="hangzhou" data-dx="9" data-dy="10">杭州</span>
            <span class="mk lv1" data-p="suzhou"></span>
            <span class="lbl lv1" data-p="suzhou" data-dx="-9" data-dy="-6" data-anchor="end">苏州</span>
            <span class="mk lv1" data-p="ningbo"></span>
            <span class="lbl lv1" data-p="ningbo" data-dx="9" data-dy="12">宁波</span>
            <span class="mk lv1" data-p="hefei"></span>
            <span class="lbl lv1" data-p="hefei" data-dx="-9" data-dy="-6" data-anchor="end">合肥</span>
            <span class="mk lv2" data-p="campus"></span>
            <span class="lbl lv2" data-p="campus" data-dx="10" data-dy="-8">徐汇</span>
          </div>
          <div class="atlas-scale">
            <span class="bar" id="scale-bar"></span>
            <span class="num" id="scale-num">1000 km</span>
          </div>
        </div>

        <div class="atlas-steps" id="steps">
          <div class="step is-on" data-i="0">
            <span class="n">01 / 中国</span>
            <h3>长江入海口</h3>
            <p>上海在长江入海口。季风、平原、密集的人口，决定了它夏天的热不是偶然。</p>
          </div>
          <div class="step" data-i="1">
            <span class="n">02 / 长江三角洲</span>
            <h3>水域与建成区交替</h3>
            <p>往近处看，冷源不是孤岛：河道与绿带把它们连成网络。</p>
          </div>
          <div class="step" data-i="2">
            <span class="n">03 / 徐汇</span>
            <h3>31.1650°N, 121.4050°E</h3>
            <p>再近一步，是这 3 公里。我的大部分数据从这里开始。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark" id="work" data-nav="dark">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mask"><span>在做的两件事。</span></h2>
        <p data-reveal>代码与项目说明公开；论文、图件与原始数据不公开，需要数据可以邮件索取。</p>
      </div>

      {projects.map((p, i) => (
        <article class="pub" data-reveal style={`--d:${i * 60}ms`}>
          <div class="year">{p.data.period.split('—')[0].trim().slice(0, 7)}</div>
          <div>
            <h3><a href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
            <p class="meta-line">{p.data.status}{p.data.methods.length ? ` · ${p.data.methods.slice(0, 4).join(' · ')}` : ''}</p>
            <p>{p.data.summary}</p>
            <div class="links">
              <a href={`/projects/${p.id}/`}>数据与复现 →</a>
              {p.data.repo && <a href={p.data.repo}>GitHub</a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  {awards.length > 0 && (
    <section class="section" id="awards">
      <div class="wrap">
        <div class="section-head">
          <h2 class="mask"><span>成果。</span></h2>
          <p data-reveal>软件著作权、论文与竞赛。</p>
        </div>
        {awards.map((a, i) => {
          const meta = [
            a.data.number && `登记号 ${a.data.number}`,
            a.data.certificate,
            a.data.issued && `${fmt(a.data.issued)} 登记`,
            a.data.holder,
            a.data.version,
          ].filter(Boolean).join(' · ');
          return (
            <article class="award" data-reveal style={`--d:${i * 60}ms`}>
              <div class="kind">{a.data.kind}</div>
              <div>
                <h3>{a.data.title}</h3>
                <p class="award-meta">{meta}</p>
                {a.data.summary && <p>{a.data.summary}</p>}
                <div class="links">
                  {a.data.related && <a href={`/projects/${a.data.related}/`}>关联项目 →</a>}
                  {a.data.link && <a href={a.data.link}>查看 →</a>}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  )}

  <section class="section" id="notes">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mask"><span>写下来的方法。</span></h2>
        <p data-reveal>投影与比例尺、反演里的坑、排版细节。都是踩过之后记的。</p>
      </div>

      {notes.map((n, i) => (
        <div class="note-row" data-reveal style={`--d:${i * 50}ms`}>
          <time datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>
          <div>
            <h3><a href={`/notes/${n.id}/`}>{n.data.title}</a></h3>
            <p>{n.data.summary}</p>
          </div>
        </div>
      ))}

      <p style="margin-top:26px"><a href="/notes/">全部笔记 →</a></p>
    </div>
  </section>

  <section class="section" id="log">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mask"><span>逐日进度。</span></h2>
        <p data-reveal>一个项目一条轨，横向排。日期取自文件与提交记录；进行中的写在最右，后续接在下面。</p>
      </div>

      {tracks.map((t, ti) => (
        <div class="track" data-reveal style={`--d:${ti * 60}ms`}>
          <div class="track-head">
            <h3>{t.title}</h3>
            <span class="track-meta">{t.entries.length} 条 · {t.status}</span>
            {t.entries.length > 4 && <span class="track-hint">横向滚动 →</span>}
          </div>

          <div class="rail">
            {t.entries.map((e) => (
              <div class="node">
                <time class="n-date" datetime={e.date}>{e.date.replace(/-/g, '.')}</time>
                <div class="n-line">
                  <span class={e.status === '完成' ? 'dot' : 'dot is-doing'}></span>
                </div>
                <div class="n-body">
                  <h4>{e.title}</h4>
                  <ul>{e.done.map((d) => <li>{d}</li>)}</ul>
                  {e.next && <p class="n-next">下一步：{e.next}</p>}
                </div>
              </div>
            ))}
            <span class="rail-fill" aria-hidden="true"></span>
          </div>

          {t.plan.length > 0 && (
            <div class="plan">
              <span class="plan-label">后续</span>
              <div class="plan-items">
                {t.plan.map((p) => (
                  <span class="plan-item"><b>{p.when}</b>{p.what}</span>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <section class="section" id="contact">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mask"><span>写信给我。</span></h2>
      </div>
      <a class="contact-big" href="mailto:zhangyx0803@petalmail.com">zhangyx0803@petalmail.com</a>
      <p style="margin-top:20px;font-family:var(--mono);font-size:12.5px;color:var(--muted)">
        <a href="https://github.com/zhangyx0803">GitHub</a> ·
        <a href="https://www.openstreetmap.org/?mlat=31.1650&mlon=121.4050#map=15/31.1650/121.4050">31.1650°N 121.4050°E</a>
      </p>
    </div>
  </section>

  <style>
    /* atlas */
    .atlas { padding-bottom: 48px; }
    .atlas-grid {
      display: grid; grid-template-columns: 1.16fr .84fr; gap: 64px;
      align-items: start; margin-top: 8px;
    }
    .atlas-stage {
      position: sticky; top: 84px; aspect-ratio: 1000 / 620;
      overflow: hidden; background: var(--paper);
      border: 1px solid var(--rule-soft);
    }
    .scene {
      position: absolute; top: 0; left: 0;
      width: 1000px; height: 620px;
      transform-origin: 0 0;
      transition: transform 1.35s cubic-bezier(.22, 1, .36, 1);
    }
    .scene > svg { display: block; width: 1000px; height: 620px; max-width: none; }
    .stage-static .scene { transition: none; }

    .atlas-labels { position: absolute; inset: 0; pointer-events: none; }
    .atlas-labels .lbl {
      position: absolute; font-family: var(--sans); font-size: 11.5px;
      letter-spacing: .02em; color: var(--ink);
      background: rgba(250, 248, 245, .88); padding: 1px 5px;
      white-space: nowrap; opacity: 0; transition: opacity .5s;
      transform: translate(0, -50%);
    }
    .atlas-labels .lbl[data-anchor="end"] { transform: translate(-100%, -50%); }
    .atlas-labels .mk {
      position: absolute; width: 5px; height: 5px; margin: -2.5px 0 0 -2.5px;
      border-radius: 50%; background: var(--terracotta); opacity: 0; transition: opacity .5s;
    }
    .atlas-stage[data-step="0"] .lv0 { opacity: 1; }
    .atlas-stage[data-step="1"] .lv1 { opacity: 1; }
    .atlas-stage[data-step="2"] .lv2 { opacity: 1; }

    .atlas-scale {
      position: absolute; left: 12px; bottom: 12px;
      display: flex; align-items: center; gap: 8px;
      font-family: var(--mono); font-size: 10.5px; color: var(--muted);
    }
    .atlas-scale .bar {
      display: block; height: 5px; border: 1px solid var(--muted); border-top: 0;
      transition: width .5s;
    }

    .atlas-steps .step {
      min-height: 62vh; display: flex; flex-direction: column; justify-content: center;
      padding: 8px 0;
    }
    .atlas-steps .n {
      font-family: var(--mono); font-size: 11px; letter-spacing: .12em;
      text-transform: uppercase; color: var(--muted); transition: color .5s;
    }
    .atlas-steps h3 {
      margin: 10px 0 8px; font-size: clamp(21px, 2.2vw, 27px);
      color: #b7aea0; transition: color .5s;
    }
    .atlas-steps p { margin: 0; color: #a89e90; max-width: 26em; transition: color .5s; }
    .atlas-steps .step.is-on .n { color: var(--terracotta); }
    .atlas-steps .step.is-on h3 { color: var(--navy); }
    .atlas-steps .step.is-on p { color: #3d372f; }

    @media (max-width: 900px) {
      .atlas-grid { display: block; }
      .atlas-stage { position: sticky; top: 62px; z-index: 5; margin-bottom: 12px; }
      .atlas-steps .step { min-height: 54vh; }
      .atlas-steps h3 { font-size: 22px; }
    }

    /* awards */
    .award {
      display: grid; grid-template-columns: 64px 1fr; gap: 28px;
      padding: 22px 0; border-top: 1px solid var(--rule-soft);
    }
    .award:first-of-type { border-top: 1px solid var(--rule); }
    .award .kind {
      font-family: var(--mono); font-size: 11px; letter-spacing: .08em;
      color: var(--terracotta); padding-top: 5px;
    }
    .award h3 { margin: 0 0 4px; font-size: 20px; }
    .award .award-meta {
      margin: 0 0 8px; font-family: var(--mono); font-size: 12.5px;
      color: var(--muted); letter-spacing: .02em;
    }
    .award p { margin: 0 0 8px; font-size: 15.5px; }
    .award .links { display: flex; flex-wrap: wrap; gap: 14px; font-size: 14px; }
    @media (max-width: 720px) { .award { grid-template-columns: 1fr; gap: 6px; } .award .kind { padding-top: 0; } }

    /* per-project rails */
    .track { margin-bottom: 52px; }
    .track:last-child { margin-bottom: 0; }
    .track-head {
      display: flex; align-items: baseline; gap: 14px;
      padding-bottom: 10px; border-bottom: 1px solid var(--rule);
    }
    .track-head h3 { margin: 0; font-size: 20px; letter-spacing: -0.012em; }
    .track-meta {
      font-family: var(--mono); font-size: 11.5px; color: var(--muted); letter-spacing: .04em;
    }
    .track-hint {
      margin-left: auto; font-family: var(--mono); font-size: 10.5px;
      letter-spacing: .08em; color: var(--terracotta);
    }

    .rail {
      display: flex; overflow-x: auto;
      scroll-snap-type: x proximity;
      padding: 24px 0 6px;
      scrollbar-width: thin;
      border-bottom: 1px solid var(--rule-soft);
    }
    .rail-fill {
      flex: 1 0 80px; align-self: flex-start;
      margin-top: 24px; border-top: 1px solid var(--rule);
    }
    .rail::-webkit-scrollbar { height: 6px; }
    .rail::-webkit-scrollbar-thumb { background: var(--rule); }

    .node {
      flex: 0 0 268px; scroll-snap-align: start;
      padding-right: 32px; position: relative;
    }
    .n-date {
      display: block; font-family: var(--mono); font-size: 11.5px;
      color: var(--muted); letter-spacing: .03em; font-variant-numeric: tabular-nums;
    }
    .n-line { position: relative; height: 0; border-top: 1px solid var(--rule); margin-top: 10px; }
    .dot {
      position: absolute; left: 0; top: -4px;
      width: 7px; height: 7px; border-radius: 50%; background: var(--terracotta);
    }
    .dot.is-doing { background: var(--paper); border: 1.5px solid var(--terracotta); }
    .n-body { padding-top: 16px; }
    .n-body h4 { margin: 0 0 7px; font-size: 16px; letter-spacing: -0.01em; line-height: 1.35; }
    .n-body ul { margin: 0; padding: 0; list-style: none; font-size: 14px; color: #3d372f; }
    .n-body li { position: relative; padding-left: 11px; margin: 3px 0; line-height: 1.55; }
    .n-body li::before { content: "·"; position: absolute; left: 1px; color: var(--terracotta); }
    .n-next {
      margin: 9px 0 0; font-size: 13px; line-height: 1.5; color: var(--muted);
      padding-left: 11px; border-left: 2px solid var(--rule);
    }

    .plan {
      display: flex; gap: 16px; flex-wrap: wrap; align-items: baseline;
      margin-top: 16px;
    }
    .plan-label {
      font-family: var(--mono); font-size: 10.5px; letter-spacing: .14em;
      text-transform: uppercase; color: var(--terracotta);
    }
    .plan-items { display: flex; flex-wrap: wrap; gap: 6px 20px; font-size: 14px; color: var(--muted); }
    .plan-item b {
      color: var(--ink); font-weight: 500; margin-right: 7px;
      font-family: var(--mono); font-size: 12px;
    }

    @media (max-width: 720px) {
      .node { flex-basis: 236px; padding-right: 24px; }
      .track-head h3 { font-size: 18px; }
    }
  </style>

  <script>
    const KM_PER_UNIT = 8.03;
    const LEVELS = [
      { x: 246.1, y: -5.6, w: 709.7, h: 508.4 },
      { x: 676.5, y: 333.2, w: 69.5, h: 45.8 },
      { x: 718.7, y: 344.8, w: 18.2, h: 16.0 },
    ];
    const POINTS = {
      shanghai: [728.5, 353.3],
      campus: [727.8, 354.4],
      nanjing: [694.3, 346.2],
      hangzhou: [714.7, 369.8],
      suzhou: [717.6, 354.1],
      ningbo: [732.7, 372.9],
      hefei: [676.4, 351.5],
    };

    const stage = document.getElementById('stage');
    const scene = document.getElementById('scene');
    const labels = [...document.querySelectorAll('.atlas-labels [data-p]')];
    const bar = document.getElementById('scale-bar');
    const num = document.getElementById('scale-num');
    const steps = [...document.querySelectorAll('#steps .step')];
    let current = 0;

    function nice(v) {
      const mag = Math.pow(10, Math.floor(Math.log10(v)));
      const n = v / mag;
      const pick = n < 1.5 ? 1 : n < 3.5 ? 2 : n < 7.5 ? 5 : 10;
      return pick * mag;
    }

    function frame(i, animate) {
      if (!stage || !scene) return;
      const p = LEVELS[i];
      const vw = stage.clientWidth;
      const vh = stage.clientHeight;
      if (!vw || !vh) return;
      const stageAspect = vw / vh;
      let rw = p.w, rh = p.h;
      if (rw / rh < stageAspect) rw = rh * stageAspect;
      else rh = rw / stageAspect;
      const cx = p.x + p.w / 2, cy = p.y + p.h / 2;
      const s = vw / rw;
      const tx = vw / 2 - cx * s;
      const ty = vh / 2 - cy * s;
      if (!animate) stage.classList.add('stage-static');
      scene.style.transform = `translate(${tx.toFixed(2)}px, ${ty.toFixed(2)}px) scale(${s.toFixed(4)})`;
      if (!animate) requestAnimationFrame(() => stage.classList.remove('stage-static'));
      stage.dataset.step = String(i);
      current = i;

      const g10 = document.getElementById('g10');
      const g2 = document.getElementById('g2');
      const g05 = document.getElementById('g05');
      if (g10) g10.style.opacity = i === 0 ? '1' : '0.25';
      if (g2) g2.style.opacity = i >= 1 ? '0.95' : '0';
      if (g05) g05.style.opacity = i >= 2 ? '0.95' : '0';

      for (const el of labels) {
        const pt = POINTS[el.dataset.p];
        el.style.left = (pt[0] * s + tx).toFixed(1) + 'px';
        el.style.top = (pt[1] * s + ty).toFixed(1) + 'px';
        const dx = Number(el.dataset.dx || 0);
        const dy = Number(el.dataset.dy || 0);
        if (dx) el.style.marginLeft = dx + 'px';
        if (dy) el.style.marginTop = dy + 'px';
      }

      const km = nice((88 / s) * KM_PER_UNIT);
      if (bar && num) {
        bar.style.width = ((km / KM_PER_UNIT) * s).toFixed(1) + 'px';
        num.textContent = km >= 1 ? Math.round(km) + ' km' : Math.round(km * 1000) + ' m';
      }
    }

    if (steps.length && stage) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const i = Number(e.target.dataset.i);
            steps.forEach((s, k) => s.classList.toggle('is-on', k === i));
            frame(i, true);
          }
        },
        { rootMargin: '-42% 0px -42% 0px', threshold: 0 }
      );
      steps.forEach((s) => io.observe(s));

      frame(0, false);
      let rz = 0;
      window.addEventListener('resize', () => {
        window.clearTimeout(rz);
        rz = window.setTimeout(() => frame(current, false), 140);
      });
    }

    const WMO = {
      0: '晴', 1: '晴间多云', 2: '多云', 3: '阴', 45: '雾', 48: '雾凇',
      51: '毛毛雨', 53: '小雨', 55: '中雨', 61: '小雨', 63: '中雨', 65: '大雨',
      71: '小雪', 73: '中雪', 75: '大雪', 80: '阵雨', 81: '阵雨', 82: '强阵雨',
      95: '雷阵雨', 96: '雷阵雨伴冰雹', 99: '强雷暴',
    };
    const wx = document.getElementById('weather');
    if (wx) {
      fetch('https://api.open-meteo.com/v1/forecast?latitude=31.165&longitude=121.405&current=temperature_2m,weather_code&timezone=Asia%2FShanghai')
        .then((r) => r.json())
        .then((d) => {
          wx.textContent = `${d.current.temperature_2m.toFixed(1)}°C · ${WMO[d.current.weather_code] ?? '—'}`;
        })
        .catch(() => { wx.textContent = '暂时不可用'; });
    }
  </script>
</Base>

---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes
    .filter((n) => !n.data.draft)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, summary, tags } = entry.data;

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: summary,
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  author: { '@type': 'Person', name: 'Zane Zhang', url: 'https://zhangyx0803.github.io/' },
  mainEntityOfPage: `https://zhangyx0803.github.io/notes/${entry.id}/`,
  keywords: tags.join(', '),
};
---

<Base title={`${title} · Zane Zhang`} description={summary} type="article" jsonLd={jsonLd}>
  <article class="article" data-nav="light">
    <div class="wrap">
      <p class="crumb"><a href="/notes/">笔记</a></p>
      <h1 data-reveal>{title}</h1>
      <p class="byline" data-reveal>
        <time datetime={date.toISOString()}>{fmt(date)}</time>
        {tags.length > 0 && <span class="tags">{tags.join(' · ')}</span>}
      </p>

      <div class="prose" data-reveal>
        <Content />
      </div>

      <nav class="article-foot">
        <a href="/notes/">← 返回笔记列表</a>
        <a href="/#contact">聊聊 →</a>
      </nav>
    </div>
  </article>

  <style>
    .article { padding: 120px 0 100px; }
    .crumb { margin: 0 0 18px; font-size: 14px; color: var(--sub); }
    .article h1 {
      margin: 0;
      font-size: clamp(28px, 4.2vw, 46px);
      line-height: 1.12;
      letter-spacing: -0.03em;
      font-weight: 600;
      max-width: 24em;
    }
    .byline {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      margin: 18px 0 46px;
      padding-bottom: 22px;
      border-bottom: 1px solid var(--line);
      font-size: 14px;
      color: var(--sub);
      font-variant-numeric: tabular-nums;
    }
    .article-foot {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 32px;
      justify-content: space-between;
      margin-top: 64px;
      padding-top: 28px;
      border-top: 1px solid var(--line);
      font-size: 16px;
    }
  </style>
</Base>

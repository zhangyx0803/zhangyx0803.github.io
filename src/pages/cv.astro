---
import Base from '../layouts/Base.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'CV · Zane Zhang',
  mainEntity: {
    '@type': 'Person',
    name: 'Zane Zhang',
    alternateName: '张永轩',
    email: 'mailto:zhangyx0803@petalmail.com',
    affiliation: { '@type': 'CollegeOrUniversity', name: '上海师范大学' },
  },
};
---

<Base title="CV · Zane Zhang" description="Zane Zhang 的简历：教育背景、研究方向、技能、成果。" jsonLd={jsonLd}>
  <section class="section" style="border-top:0">
    <div class="wrap">
      <h1 class="page-title">
        <span class="t-zh">简历</span><span class="t-en">Curriculum Vitae</span>
      </h1>

      <dl class="meta-grid">
        <div>
          <dt><span class="t-zh">姓名</span><span class="t-en">Name</span></dt>
          <dd><span class="t-zh">Zane Zhang（张永轩）</span><span class="t-en">Zane Zhang</span></dd>
        </div>
        <div>
          <dt><span class="t-zh">单位</span><span class="t-en">Affiliation</span></dt>
          <dd>
            <span class="t-zh">上海师范大学 · 环境与地理科学学院</span>
            <span class="t-en">Shanghai Normal University · School of Environmental and Geographical Sciences</span>
          </dd>
        </div>
        <div>
          <dt><span class="t-zh">专业</span><span class="t-en">Major</span></dt>
          <dd>
            <span class="t-zh">地理信息科学 · 本科</span><span class="t-en">Geographic Information Science, BSc</span>
          </dd>
        </div>
        <div>
          <dt><span class="t-zh">邮箱</span><span class="t-en">Email</span></dt>
          <dd><a href="mailto:zhangyx0803@petalmail.com">zhangyx0803@petalmail.com</a></dd>
        </div>
      </dl>

      <div class="prose">
        <h2><span class="t-zh">教育</span><span class="t-en">Education</span></h2>
        <table>
          <tbody>
            <tr>
              <td>2025 — 2029</td>
              <td>
                <span class="t-zh">上海师范大学 · 环境与地理科学学院 · 地理信息科学 · 本科</span>
                <span class="t-en">Shanghai Normal University · School of Environmental and Geographical Sciences · BSc in Geographic Information Science</span>
              </td>
            </tr>
          </tbody>
        </table>

        <h2><span class="t-zh">研究方向</span><span class="t-en">Research interests</span></h2>
        <table>
          <tbody>
            <tr>
              <td><span class="t-zh">方向一</span><span class="t-en">Field</span></td>
              <td>
                <span class="t-zh">城市热环境</span><span class="t-en">Urban thermal environment</span>
              </td>
            </tr>
            <tr>
              <td><span class="t-zh">方向二</span><span class="t-en">Field</span></td>
              <td>
                <span class="t-zh">景观生态</span><span class="t-en">Landscape ecology</span>
              </td>
            </tr>
            <tr>
              <td><span class="t-zh">方向三</span><span class="t-en">Field</span></td>
              <td>
                <span class="t-zh">地理学科教育</span><span class="t-en">Geography education</span>
              </td>
            </tr>
          </tbody>
        </table>

        <h2><span class="t-zh">实习</span><span class="t-en">Internship</span></h2>
        <table>
          <tbody>
            <tr>
              <td>2026.07.06 — 2026.08.14</td>
              <td>
                <span class="t-zh">昂立少儿 · 托管助教（40 天）</span>
                <span class="t-en">Only Education (Shanghai) · after-school care assistant, 40 days</span>
              </td>
            </tr>
          </tbody>
        </table>

        <h2><span class="t-zh">技能</span><span class="t-en">Skills</span></h2>
        <ul>
          <li>
            <span class="t-zh">空间分析：MSPA、最小累积阻力、电路理论、空间统计</span>
            <span class="t-en">Spatial analysis: MSPA, MCR, circuit theory, spatial statistics</span>
          </li>
          <li>
            <span class="t-zh">工具：ArcGIS Pro（arcpy）、QGIS、Python、R、C++</span>
            <span class="t-en">Tools: ArcGIS Pro (arcpy), QGIS, Python, R, C++</span>
          </li>
          <li>
            <span class="t-zh">制图：专题制图、图集编排、脚本化出图（SVG / Pillow）</span>
            <span class="t-en">Cartography: thematic maps, atlas layout, scripted output</span>
          </li>
        </ul>


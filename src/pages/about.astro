---
import Base from '../layouts/Base.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: '关于 Zane Zhang',
  mainEntity: {
    '@type': 'Person',
    name: 'Zane Zhang',
    jobTitle: '地理信息科学',
    email: 'mailto:zhangyx0803@petalmail.com',
    sameAs: ['https://github.com/zhangyx0803'],
  },
};
---

<Base title="关于 · Zane Zhang" description="Zane Zhang，地理信息科学。研究城市冷岛网络、遥感反演与专题制图。" jsonLd={jsonLd}>
  <section class="section" data-nav="light">
    <div class="wrap narrow">
      <p class="crumb"><a href="/">Zane Zhang</a></p>
      <h1 class="page-title" data-reveal>关于</h1>

      <div class="prose" data-reveal style="margin-top:36px">
        <p>
          地理信息科学本科在读，坐标上海徐汇（31.1650°N、121.4050°E）。
          关心城市里的冷与热：冷源在哪里、廊道在哪里断、修复该先从哪一段开始。
        </p>
        <p>
          手上的两件事：一是上海市冷岛网络的跨期分析，用三期遥感影像和网络方法回答
          「十年怎么变、变化来自哪、先修哪里」；二是一套从公开点评出发的游客情感分析流程，
          把采集、清洗、分类、建模拆成能单独跑的步骤。
        </p>

        <h2>能做的</h2>
        <ul>
          <li>遥感：Landsat 8/9 预处理、地表温度反演、植被与水体指数、土地覆被</li>
          <li>空间分析：MSPA、最小累积阻力、电路理论夹点、空间统计与网络连通性</li>
          <li>制图：专题制图、图集编排、用脚本批量出图（SVG / Pillow）</li>
          <li>工具：ArcGIS Pro（arcpy）、QGIS、Python、R、C++</li>
        </ul>

        <h2>关于数据</h2>
        <p>
          公开仓库里只放项目说明与代码，不放论文原文、图件和原始数据。
          如果你要复现其中某一项，把用途说明发到
          <a href="mailto:zhangyx0803@petalmail.com">zhangyx0803@petalmail.com</a>，
          我把能提供的部分整理给你。
        </p>

        <h2>联系</h2>
        <p>
          邮件最快：<a href="mailto:zhangyx0803@petalmail.com">zhangyx0803@petalmail.com</a> ·
          GitHub：<a href="https://github.com/zhangyx0803">@zhangyx0803</a>
        </p>
      </div>
    </div>
  </section>

  <style>
    .section { padding: 120px 0 100px; }
    .narrow { max-width: 760px; }
    .crumb { margin: 0 0 18px; font-size: 14px; color: var(--muted); }
    .page-title {
      margin: 0;
      font-size: clamp(34px, 5vw, 60px);
      letter-spacing: -0.04em;
      line-height: 1.05;
      font-weight: 600;
    }
  </style>
</Base>

---
import Base from '../layouts/Base.astro';
---

<Base title="页面不存在 · Zane Zhang" description="这个地址没有内容。">
  <section class="section" data-nav="light">
    <div class="wrap">
      <h1 class="code">404</h1>
      <p class="msg">
        <span class="t-zh">这个地址没有内容。可能是链接过期，或者我把它挪走了。</span>
        <span class="t-en">Nothing here. The link may be outdated, or the page moved.</span>
      </p>
      <p>
        <a href="/">
          <span class="t-zh">回到首页 →</span><span class="t-en">Back to home →</span>
        </a>
      </p>
    </div>
  </section>

  <style>
    .section { padding: 160px 0 120px; }
    .code { margin: 0; font-size: clamp(64px, 12vw, 140px); letter-spacing: -0.05em; line-height: 1; font-weight: 600; }
    .msg { margin: 18px 0 26px; font-size: 18px; color: var(--muted); }
  </style>
</Base>

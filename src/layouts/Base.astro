---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  image?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, type = 'website', image = '/og.png', jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const siteName = 'Zane Zhang';
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical.href} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <meta name="author" content="Zane Zhang" />
  <meta name="theme-color" content="#faf8f5" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&display=swap"
    rel="stylesheet"
  />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={`${siteName} · RSS`} href="/rss.xml" />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical.href} />
  <meta property="og:image" content={ogImage.href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="zh_CN" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage.href} />

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a class="skip" href="#main">跳到正文</a>

  <header class="site-header" id="site-header">
    <nav class="wrap">
      <a class="brand" href="/">Zane Zhang</a>
      <div class="links">
        <a href="/projects" class="opt">研究</a>
        <a href="/notes">笔记</a>
        <a href="/about" class="opt">关于</a>
        <a href="/#contact">联系</a>
      </div>
    </nav>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <span>© <span id="year">2026</span> Zane Zhang · 上海</span>
      <span>
        <a href="/rss.xml">RSS</a> ·
        <a href="/sitemap-index.xml">Sitemap</a> ·
        <a href="https://github.com/zhangyx0803">GitHub</a>
      </span>
    </div>
  </footer>

  <script>
    const yearEl = document.getElementById('year');
    if (yearEl) yearEl.textContent = String(new Date().getFullYear());

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      import('lenis').then(({ default: Lenis }) => {
        const lenis = new Lenis({ autoRaf: true, duration: 1.05, smoothWheel: true });
        document.querySelectorAll('a[href^="/#"], a[href^="#"]').forEach((a) => {
          a.addEventListener('click', (e) => {
            const id = a.getAttribute('href').replace(/^\/?#/, '');
            const target = id ? document.getElementById(id) : null;
            if (!target) return;
            e.preventDefault();
            lenis.scrollTo(target, { offset: -64 });
          });
        });
      });
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );
    document.querySelectorAll('[data-reveal], .mask').forEach((el, i) => {
      if (!el.style.getPropertyValue('--d')) el.style.setProperty('--d', `${(i % 4) * 60}ms`);
      io.observe(el);
    });

    const header = document.getElementById('site-header');
    const themed = [...document.querySelectorAll('[data-nav]')];
    const syncHeader = () => {
      let dark = false;
      for (const section of themed) {
        const r = section.getBoundingClientRect();
        if (r.top <= 26 && r.bottom > 26) {
          dark = section.dataset.nav === 'dark';
          break;
        }
      }
      header?.classList.toggle('on-dark', dark);
      header?.classList.toggle('is-scrolled', window.scrollY > 8 && !dark);
    };
    window.addEventListener('scroll', syncHeader, { passive: true });
    syncHeader();

    const hand = document.querySelector('.hand');
    if (hand) requestAnimationFrame(() => hand.classList.add('is-written'));
  </script>

  <style>
    .skip {
      position: absolute; left: -9999px; top: 0;
      padding: 10px 14px; background: var(--navy-ink); color: var(--cream);
      z-index: 100; border-bottom: 0;
    }
    .skip:focus { left: 12px; top: 12px; }
  </style>
</body>
</html>

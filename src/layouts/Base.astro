---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const { title, description, type = 'website', jsonLd } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const siteName = 'Zane Zhang';
---

<!doctype html>
<html lang="zh-CN" data-lang="zh">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    try {
      var saved = localStorage.getItem('lang');
      if (saved === 'en' || saved === 'zh') document.documentElement.dataset.lang = saved;
    } catch (e) {}
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical.href} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <meta name="author" content="Zane Zhang" />
  <meta name="theme-color" content="#faf8f5" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Noto+Serif+SC:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical.href} />
  <meta property="og:image" content={ogImage.href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="zh_CN" />
  <meta property="og:locale:alternate" content="en_US" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage.href} />

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a class="skip" href="#main">跳到正文</a>

  <header class="site-header">
    <nav class="wrap">
      <a class="brand" href="/">Zane Zhang</a>
      <div class="links">
        <a href="/projects/">
          <span class="t-zh">研究</span><span class="t-en">Research</span>
        </a>
        <a href="/cv/">
          <span class="t-zh">简历</span><span class="t-en">CV</span>
        </a>
        <a href="/#contact">
          <span class="t-zh">联系</span><span class="t-en">Contact</span>
        </a>
      </div>
      <div class="lang-switch" role="group" aria-label="Language">
        <button type="button" data-lang-btn="zh" aria-pressed="true">中</button>
        <span aria-hidden="true">/</span>
        <button type="button" data-lang-btn="en" aria-pressed="false">EN</button>
      </div>
    </nav>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <span>© <span id="year">2026</span> Zane Zhang</span>
      <span>
        <span class="t-zh">更新于 2026.11</span><span class="t-en">Last updated 2026.11</span>
      </span>
    </div>
  </footer>

  <script>
    const root = document.documentElement;
    const applyLang = (lang) => {
      root.dataset.lang = lang;
      root.lang = lang === 'zh' ? 'zh-CN' : 'en';
      try { localStorage.setItem('lang', lang); } catch (e) {}
      document.querySelectorAll('[data-lang-btn]').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.langBtn === lang));
      });
    };
    document.querySelectorAll('[data-lang-btn]').forEach((b) => {
      b.addEventListener('click', () => applyLang(b.dataset.langBtn));
    });
    applyLang(root.dataset.lang === 'en' ? 'en' : 'zh');

    const yearEl = document.getElementById('year');
    if (yearEl) yearEl.textContent = String(new Date().getFullYear());

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        },
        { threshold: 0.08, rootMargin: '0px 0px -6% 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    } else {
      document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in'));
    }
  </script>
</body>
</html>
